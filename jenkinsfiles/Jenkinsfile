pipeline {

    agent any

    parameters {

        string(
            name: 'APP_REPOSITORY',
            defaultValue: 'https://github.com/jad-raounak/myi-unicom-nova-ai.git',
            description: 'Repository of the application to build'
        )

        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Branch to build'
        )

    }

    stages {

        stage('Initialization') {
            steps {

                echo '======================================='
                echo ' DevSecOps Platform Pipeline Started'
                echo '======================================='

                echo "Repository : ${params.APP_REPOSITORY}"
                echo "Branch     : ${params.APP_BRANCH}"

            }
        }

        stage('Checkout Application') {
            steps {

                dir('application') {

                    git(
                        url: params.APP_REPOSITORY,
                        branch: params.APP_BRANCH,
                        credentialsId: 'github-pat'
                    )

                }

            }
        }

        stage('Verify Application') {
            steps {

                dir('application') {

                    sh '''
                        echo "======================================="
                        echo "Application successfully cloned"
                        echo "======================================="

                        echo ""
                        echo "Application root:"
                        pwd

                        echo ""
                        echo "Application content:"
                        ls -la

                        echo ""
                        echo "Checking Dockerfile..."
                        test -f Dockerfile
                        echo "Dockerfile found."

                        echo ""
                        echo "Checking composer.json..."
                        test -f composer.json
                        echo "composer.json found."

                        echo ""
                        echo "Application verification completed."
                    '''

                }

            }
        }

    }

    post {

        success {
            echo 'Pipeline executed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }

        always {
            echo 'End of pipeline.'
        }

    }

}
