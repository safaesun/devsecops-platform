pipeline {

    agent any

    parameters {

        string(
            name: 'APP_REPOSITORY',
            defaultValue: '',
            description: 'Git repository URL of the application'
        )

        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Git branch of the application'
        )

    }

    stages {

        stage('Initialization') {

            steps {

                script {

                    if (!params.APP_REPOSITORY?.trim()) {
                        error("APP_REPOSITORY was not received from the webhook.")
                    }

                    if (!params.APP_BRANCH?.trim()) {
                        error("APP_BRANCH was not received from the webhook.")
                    }

                    env.APP_REPOSITORY = params.APP_REPOSITORY

                    env.APP_BRANCH = params.APP_BRANCH.replace("refs/heads/", "")

                }

                echo '======================================='
                echo ' DevSecOps Platform Pipeline Started'
                echo '======================================='

                echo "Application Repository : ${env.APP_REPOSITORY}"
                echo "Application Branch     : ${env.APP_BRANCH}"

            }

        }

        stage('Checkout Application') {

            steps {

                dir('application') {

                    git(
                        url: env.APP_REPOSITORY,
                        branch: env.APP_BRANCH,
                        credentialsId: 'github-pat'
                    )

                }

            }

        }

        stage('Verify Application') {

            steps {

                dir('application') {

                    sh '''
                        echo "======================================="
                        echo "Application successfully cloned"
                        echo "======================================="

                        echo ""
                        echo "Application root:"
                        pwd

                        echo ""
                        echo "Application content:"
                        ls -la

                        echo ""
                        echo "Checking Dockerfile..."
                        test -f Dockerfile
                        echo "Dockerfile found."

                        echo ""
                        echo "Checking composer.json..."
                        test -f composer.json
                        echo "composer.json found."

                        echo ""
                        echo "Application verification completed."
                    '''

                }

            }

        }

        stage('Detect Project') {

            steps {

                dir('application') {

                    script {

                        def output = sh(
                            script: '../scripts/detect-project.sh',
                            returnStdout: true
                        ).trim()

                        echo output

                        output.split("\n").each { line ->

                            def parts = line.tokenize("=")

                            if (parts.size() == 2) {

                                env."${parts[0]}" = parts[1]

                            }

                        }

                        echo "Detected language : ${env.LANGUAGE}"
                        echo "Detected build tool : ${env.BUILD_TOOL}"

                    }

                }

            }

        }

        stage('Retrieve Secrets') {

            steps {

                dir('application') {

                    script {

                        withCredentials([
                            string(
                                credentialsId: 'vault-token',
                                variable: 'VAULT_TOKEN'
                            )
                        ]) {

                            def output = sh(
                                script: '../scripts/retrieve-secrets.sh',
                                returnStdout: true
                            ).trim()

                            output.split("\n").each { line ->

                                if (line.startsWith("GITHUB_TOKEN=")) {
                                    env.GITHUB_TOKEN = line.replace("GITHUB_TOKEN=", "")
                                }

                                if (line.startsWith("SONAR_TOKEN=")) {
                                    env.SONAR_TOKEN = line.replace("SONAR_TOKEN=", "")
                                }

                                if (line.startsWith("SONAR_HOST_URL=")) {
                                    env.SONAR_HOST_URL = line.replace("SONAR_HOST_URL=", "")
                                }

                                if (line.startsWith("NVD_API_KEY=")) {
                                    env.NVD_API_KEY = line.replace("NVD_API_KEY=", "")
                                }

                                if (line.startsWith("COSIGN_PASSWORD=")) {
                                    env.COSIGN_PASSWORD = line.replace("COSIGN_PASSWORD=", "")
                                }

                            }

                            echo "Vault secrets successfully retrieved."
                            echo "NVD API Key loaded: ${env.NVD_API_KEY ? 'YES' : 'NO'}"

                        }

                    }

                }

            }

        }

        stage('Build Application') {

            steps {

                dir('application') {

                    sh '../scripts/build.sh'

                }

            }

        }
        stage('SonarQube Analysis') {

            steps {

                dir('application') {

                    sh '../scripts/sonarqube.sh'

                }

            }

        }
        stage('OWASP Dependency Check') {

            steps {

                dir('application') {

                    sh '../scripts/dependency-check.sh'

                }

            }

        }
        stage('Gitleaks Secret Scan') {

            steps {

                dir('application') {

                    sh '../scripts/gitleaks.sh'

                }

            }

        }
        stage('Build Docker Image') {

            steps {

                dir('application') {

                    sh '../scripts/build-image.sh'

                }

            }

        }
        stage('Trivy Filesystem Scan') {

            steps {
 
                dir('application') {
 
                    sh '../scripts/trivy.sh'

                 }

            }

        }
        stage('Trivy Docker Image Scan') {

            steps {

                dir('application') {

                    sh '../scripts/trivy-image.sh'

                }

            }

        }
        stage('Cleanup') {

            steps {

                dir('application') {

                    sh '../scripts/cleanup.sh'

                }

            }

        }
    }

    post {

        success {

            echo "======================================="
            echo "Pipeline executed successfully."
            echo "======================================="

        }

        failure {

            echo "======================================="
            echo "Pipeline failed."
            echo "======================================="

        }

        always {
             

            archiveArtifacts artifacts: 'application/reports/**/*.html', fingerprint: true
     
            archiveArtifacts artifacts: 'application/reports/**/*.json', fingerprint: true

            archiveArtifacts artifacts: 'application/reports/**/*.xml', fingerprint: true

            archiveArtifacts artifacts: 'application/reports/**/*.txt', fingerprint: true
     
            cleanWs()

            echo "======================================="
            echo "End of pipeline."
            echo "======================================="

        }

    }

}
